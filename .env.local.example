# Copy this file to .env.local and fill in your own Sanity project details.
# Get these from https://www.sanity.io/manage after creating a free project
# (see README.md "Getting Started").

# Public — safe to expose to the browser, used by the site and the embedded Studio.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-06-01

# Secret — only used server-side by `npm run seed`. Create at
# https://www.sanity.io/manage -> your project -> API -> Tokens -> "Add API token"
# with "Editor" permissions. Never commit this value or expose it to the browser.
SANITY_API_WRITE_TOKEN=
